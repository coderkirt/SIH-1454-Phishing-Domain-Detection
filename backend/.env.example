HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this
DATABASE_URL=sqlite:///./threats.db
ENVIRONMENT=development
ENABLE_ONLINE_CHECKS=true

# Optional. Without these, PHISHEYE still uses public OpenPhish / URLhaus / Phishing Army lists.
# The PhishTank public dump is verified-only. Unverified reports need the live API key.
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_AUTH_KEY=
